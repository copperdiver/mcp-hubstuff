{
  "name": "hubstaff-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only remote MCP server for Hubstaff and Hubstaff Tasks",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
