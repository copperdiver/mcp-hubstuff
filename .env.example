# Choose exactly one Hubstaff authentication option.
# Recommended for a long-running organization service:
HUBSTAFF_ORGANIZATION_TOKEN=hsoat_replace_me

# Alternative: short-lived access token.
# HUBSTAFF_ACCESS_TOKEN=replace_me

# Alternative: Personal Access Token (PAT). Hubstaff gives you a refresh token;
# the server exchanges it and persists rotated tokens under TOKEN_CACHE_PATH.
# HUBSTAFF_REFRESH_TOKEN=replace_me

# OAuth refresh mode only (not needed for PAT or organization tokens).
# HUBSTAFF_AUTH_MODE=oauth
# HUBSTAFF_CLIENT_ID=replace_me
# HUBSTAFF_CLIENT_SECRET=replace_me

# Protects the public MCP endpoint. Generate a long random value.
MCP_AUTH_TOKEN=replace_with_at_least_32_random_characters

PORT=3000
HUBSTAFF_API_BASE=https://api.hubstaff.com
HUBSTAFF_TOKEN_URL=https://account.hubstaff.com/access_tokens
TOKEN_CACHE_PATH=/data/token.json
REQUEST_TIMEOUT_MS=30000
